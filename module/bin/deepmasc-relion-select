#!/usr/bin/env bash
#
# DeepMASC - RELION AutoSelect3D wrapper script
# This script runs the gtf_relion4_run_select_class3d.py script using the conda environment Python
#

# Check if DEEPMASC_PYTHON is set (should be set by the module)
if [ -z "$DEEPMASC_PYTHON" ]; then
    echo "Error: DEEPMASC_PYTHON not set. Did you load the module?"
    echo "Run: module load deepmasc"
    exit 1
fi

# Check if Python exists
if [ ! -f "$DEEPMASC_PYTHON" ]; then
    echo "Error: Python interpreter not found at: $DEEPMASC_PYTHON"
    echo "Please check your conda environment installation."
    exit 1
fi

# Run the RELION select class3d script with all arguments passed to this script
exec "$DEEPMASC_PYTHON" "$DEEPMASC_ROOT/gtf_relion4_run_select_class3d.py" "$@"
